<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>spring-ai-ollama-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>spring-ai-ollama-demo</name>
    <description>Demo Spring AI com modelo local Ollama (granite4.1:3b)</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.1.8</spring-ai.version>
        <spring-ai-alibaba.version>1.1.2.4-security-fix</spring-ai-alibaba.version>
        <!-- Boot's managed testcontainers ships a docker-java using API <1.44 —
             rejected by Docker Engine 29 (minimum API 1.44). 1.21.4 negotiates. -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- Overrides of Boot-managed versions for CVE fixes (Trivy HIGH/CRITICAL):
             tomcat CVE-2026-65182/65905/68525, netty CVE-2026-59901/75595,
             postgresql CVE-2026-54291. mcp-core 0.18.3 (CVE-2026-35568) is
             pinned by spring-ai-client-chat 1.1.8 — needs a Spring AI bump. -->
        <tomcat.version>10.1.60</tomcat.version>
        <netty.version>4.1.138.Final</netty.version>
        <postgresql.version>42.7.12</postgresql.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Spring AI Ollama starter: integra com o modelo local no Ollama -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <!-- Observabilidade: health/metrics endpoints + scrape Prometheus.
             Com o Actuator no classpath, o Spring AI publica automaticamente as
             observacoes de chat (spring.ai.*) no registry do Micrometer. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-advisors-vector-store</artifactId>
        </dependency>
        <!-- Spring AI Alibaba DashScope (Qwen) - cloud alternative to Ollama, requires DASHSCOPE_API_KEY.
             Since Alibaba 1.1.x the starter moved out of the main BOM: its version
             comes from the spring-ai-alibaba-extensions-bom imported below. -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- OpenAPI/Swagger UI: interactive API docs at /swagger-ui.html (spec at /v3/api-docs).
             Pinned to 2.8.14: 2.8.15+ breaks context startup on Boot 3.4.x with
             "Invalid mapping pattern detected: /swagger-ui/**/*swagger-initializer.js"
             (springdoc-openapi#3210). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.14</version>
        </dependency>
        <!-- Rate limit distribuido (opt-in via app.rate-limit.store=redis, padrao
              do prod). O Lettuce conecta de forma lazy: sem servidor configurado
              nada muda — o interceptor usa o bucket em memoria. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
              <!-- Producao: PostgreSQL (chat memory JDBC + pgvector). O starter JDBC do
              Spring AI ja cria o schema da memoria de chat no Postgres; o driver
              fica disponivel em todos os perfis mas so e usado quando a URL aponta
              para postgres (perfil prod). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Vector store externo (opt-in via app.rag.store=pgvector, padrao do prod).
              Usado manualmente em RagConfig; a auto-config do starter fica excluida
              em application.yml para nao ativar no HSQLDB dos testes/dev. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>
        <!-- Memoria de chat persistente: JdbcChatMemoryRepository + HSQLDB em arquivo
              (./data/chat-memory), sobrevive a restarts. HSQLDB e uma das plataformas
              com schema oficial no starter; o perfil prod aponta o mesmo starter para
              PostgreSQL (driver acima, sem troca de codigo). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hsqldb</groupId>
            <artifactId>hsqldb</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- E2E opcional com Ollama real em container (executar com:
             E2E_OLLAMA=true ./mvnw test -Dtest=OllamaE2EIT -DfailIfNoTests=false) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>ollama</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- E2E opcional do pgvector (E2E_PG=true ... -Dtest=PgVectorE2EIT): sobe
              pgvector/pgvector e valida o wiring do store externo sem mocks. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Own BOMs for the Spring AI Alibaba artifacts (com.alibaba.cloud.ai):
                 from 1.1.x the DashScope starter is managed by the extensions BOM,
                 while the main BOM covers the core modules. -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-extensions-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- CVE-2026-40682/42027/42440 (CRITICAL/HIGH): Alibaba dashscope
                 pins opennlp-tools 2.3.3; entry wins over any imported BOM. -->
            <dependency>
                <groupId>org.apache.opennlp</groupId>
                <artifactId>opennlp-tools</artifactId>
                <version>2.5.9</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- E2E lives under e2e/ and runs only via explicit
                         -Dtest=... with its env opt-in (E2E_OLLAMA/E2E_PG/E2E_REDIS):
                         never part of the default build or CI. -->
                    <excludes>
                        <exclude>**/e2e/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- Coverage: report always; check locks the measured floor (see rules below). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Ratchet: fails the build if coverage drops below the floor
                         measured at introduction (LINE 67%, BRANCH 54%). Current
                         measured: LINE 67.1%, BRANCH 56.3% — floors sit ~2pp below.
                         Raise the minimums when new code lifts the actuals. -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.65</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.54</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
